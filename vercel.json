{
  "name": "anoint-array",
  "version": 2,
  "project": "prj_rc4JpBUeOGNDdts7FApnqxopbeC0",
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@next_public_supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@next_public_supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key",
    "OPENAI_API_KEY": "@openai_api_key",
    "ANTHROPIC_API_KEY": "@anthropic_api_key",
    "SUPABASE_ADMIN_EMAIL": "@supabase_admin_email",
    "SUPABASE_ADMIN_PASSWORD": "@supabase_admin_password",
    "CANPOST_DEV_USERNAME": "@canpost_dev_username",
    "CANPOST_DEV_PASSWORD": "@canpost_dev_password", 
    "CANPOST_PROD_USERNAME": "@canpost_prod_username",
    "CANPOST_PROD_PASSWORD": "@canpost_prod_password",
    "UPS_CLIENT_ID": "@ups_client_id",
    "UPS_SECRET": "@ups_secret",
    "PAYPAL_CLIENT_ID_SANDBOX": "@paypal_client_id_sandbox",
    "PAYPAL_CLIENT_SECRET_SANDBOX": "@paypal_client_secret_sandbox",
    "PAYPAL_CLIENT_ID_LIVE": "@paypal_client_id_live",
    "PAYPAL_SECRET_LIVE": "@paypal_secret_live",
    "STRIPE_SECRET_KEY": "@stripe_secret_key",
    "STRIPE_PUBLISH_KEY": "@stripe_publish_key",
    "STRIPE_WEBHOOK_SECRET": "@stripe_webhook_secret",
    "RESEND_API_KEY": "@resend_api_key",
    "NOWPAYMENTS_PUBLIC_KEY": "@nowpayments_public_key",
    "NOWPAYMENTS_API_KEY": "@nowpayments_api_key",
    "FOURTHWALL_API_USERNAME": "@fourthwall_api_username",
    "FOURTHWALL_API_PASSWORD": "@fourthwall_api_password",
    "FOURTHWALL_STOREFRONT_TOKEN": "@fourthwall_storefront_token"
  },
  "build": {
    "env": {
      "SKIP_TYPE_CHECK": "true",
      "SKIP_LINT": "true"
    }
  },
  "functions": {
    "app/api/**/*": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}